<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- LIST VIEW -->
    <record id="view_housing_transfer_list" model="ir.ui.view">
        <field name="name">housing.transfer.list</field>
        <field name="model">housing.transfer</field>
        <field name="arch" type="xml">
            <list>
                <field name="plot_id"/>
                <field name="block_id" readonly="1"/>
                <field name="from_member_id"/>
                <field name="to_member_id"/>
                <field name="transfer_date"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_housing_transfer_form" model="ir.ui.view">
        <field name="name">housing.transfer.form</field>
        <field name="model">housing.transfer</field>
        <field name="arch" type="xml">
            <form>

                <!-- HEADER BUTTONS -->
                <header>
                    <button name="action_print_transfer_allotment"
                            type="object"
                            string="Transfer Allotment"
                            class="btn-primary"
                            icon="fa-file-pdf"/>

                    
                </header>

                <sheet>
                    <group>
                        <field name="plot_id"/>
                        <field name="block_id" readonly="1"/>
                        <field name="from_member_id"/>
                        <field name="to_member_id"/>
                        <field name="transfer_date"/>
                        <field name="remarks"/>
                    </group>
                </sheet>

            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_housing_transfer" model="ir.actions.act_window">
        <field name="name">Transfers</field>
        <field name="res_model">housing.transfer</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
