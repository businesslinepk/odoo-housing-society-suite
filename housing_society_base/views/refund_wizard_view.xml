<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_refund_wizard_form" model="ir.ui.view">
        <field name="name">housing.refund.wizard.form</field>
        <field name="model">housing.refund.wizard</field>
        <field name="arch" type="xml">
            <form string="Refund">
                <group>
                    <field name="member_id" readonly="1"/>
                    <field name="refund_amount"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button string="Confirm Refund"
                            type="object"
                            name="action_confirm_refund"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!--  THIS ACTION IS MISSING IN YOUR SYSTEM -->
    <record id="action_refund_wizard" model="ir.actions.act_window">
        <field name="name">Refund</field>
        <field name="res_model">housing.refund.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_member_id': active_id}</field>
    </record>

</odoo>
