<odoo>
 <data>

    <!-- ROOT ACTION -->
    <record id="action_housing_root" model="ir.actions.act_window">
        <field name="name">Housing Society</field>
        <field name="res_model">housing.society</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ROOT MENU (THIS MAKES APP VISIBLE) -->
    <menuitem
        id="housing_root"
        name="Housing Society"
        action="action_housing_root"
        sequence="10"/>

