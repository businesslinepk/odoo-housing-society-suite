        action="action_housing_society"/> --> 
     <!-- <menuitem
        id="housing_block_menu"
        name="Blocks"
        parent="housing_root"
        action="action_housing_block"/> -->

        <!-- Memberships -->
        <menuitem
       id="housing_member_menu"
       name="Memberships"
       parent="housing_root"
