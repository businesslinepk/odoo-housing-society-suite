<?xml version="1.0" encoding="UTF-8"?>
<odoo>


 <template id="portal_my_ledger" name="My Ledger">
    <t t-call="portal.portal_layout">
        <div class="container">
            <h3>My Ledger</h3>

            <t t-if="member">
                <p><strong>Membership:</strong> <t t-esc="member.membership_no"/></p>

                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Description</th>
                            <th>Debit</th>
                            <th>Credit</th>
                            <th>Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="ledger_lines" t-as="l">
                            <tr>
                                <td><t t-esc="l.date"/></td>
                                <td><t t-esc="l.description"/></td>
                                <td><t t-esc="l.debit"/></td>
                                <td><t t-esc="l.credit"/></td>
                                <td><t t-esc="l.balance"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>

            <t t-else="">
                <p>No ledger found.</p>
            </t>
        </div>
    </t>
 </template>
</odoo>