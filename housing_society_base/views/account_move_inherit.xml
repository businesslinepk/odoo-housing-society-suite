<record id="view_move_form_inherit_housing" model="ir.ui.view">
    <field name="name">account.move.form.housing</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
        <xpath expr="//notebook" position="inside">
            <page string="Housing">
                <field name="housing_installment_id"/>
                <field name="membership_no"/>
            </page>
        </xpath>
    </field>
</record>
