<odoo>
    <record id="view_housing_society_list" model="ir.ui.view">
        <field name="model">housing.society</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="city"/>
            </list>
        </field>
    </record>

    <record id="action_housing_society" model="ir.actions.act_window">
        <field name="name">Societies</field>
        <field name="res_model">housing.society</field>
        <field name="view_mode">list,form</field>
    </record>
   
</odoo> 
