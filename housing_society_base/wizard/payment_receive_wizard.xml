<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_payment_receive_wizard" model="ir.ui.view">
        <field name="name">housing.payment.receive.wizard.form</field>
        <field name="model">housing.payment.receive.wizard</field>
        <field name="arch" type="xml">
            <form string="Receive Payment">
                <group>
                    <field name="member_id"/>
                    <field name="installment_id"/>
                    <field name="amount"/>
                    <field name="payment_date"/>
                    <field name="payment_method"/>
                </group>

                <footer>
                    <button name="action_confirm_payment"
                            type="object"
                            string="Confirm Payment"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
